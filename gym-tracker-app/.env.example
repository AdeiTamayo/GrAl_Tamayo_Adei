// Copy this file to `.env` in the same folder (gym-tracker-app/) and fill in
// your own values. `.env` is git-ignored and must never be committed.

PORT=8000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_tracker
DB_USER=postgres
DB_PASSWORD=your_password

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret

# Optional. Full path to the Python interpreter used for video analysis.
# Leave unset to auto-detect `python3` / `python` / `py`.
# PYTHON_PATH=/usr/bin/python3

# Optional. Public base URL of this API, used to build the links to processed
# videos. Set it when the API is not reached on http://localhost:8000.
# PUBLIC_API_URL=https://api.example.com

# Optional. Comma-separated list of frontend origins allowed by CORS.
# Leave unset to allow any origin (safe, because auth uses a Bearer token
# rather than cookies).
# CORS_ORIGIN=http://localhost:3000
