# Environment for the archived backend's helper scripts.
#
# Only needed to run `npm run seed` and `npm run db:check` from legacy/backend.
# The frontend has its own separate .env (REACT_APP_SUPABASE_URL /
# REACT_APP_SUPABASE_ANON_KEY) in gym-tracker-app/frontend/.
#
# Copy to legacy/.env and fill in. Never commit the result.

# Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key bypasses Row Level Security. Server-side scripts only.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Publishable/anon key, RLS-aware. Only needed if you also exercise the API.
SUPABASE_ANON_KEY=your-anon-key

# RapidAPI -> ExerciseDB, used by scripts/populateExercices.ts to seed the
# shared `exercises` catalogue.
RAPIDAPI_KEY=your-rapidapi-key

# Roboflow, used only by python/barbell_tracking.py. Not required by the
# browser-based analysis that the live app performs.
ROBOFLOW_API_KEY=your-roboflow-key
